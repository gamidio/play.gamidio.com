# Gegno Civilians:

ship "Shale"
	sprite "ship/gegno shale"
	thumbnail "thumbnail/gegno shale"
	attributes
		category "Transport"
		licenses
			"Gegno Civilian"
		"cost" 148000
		"shields" 0
		"hull" 800
