		from 0 -80 to -90 -130
	active if "!max zoom"
	button + "_+"
		from -10 -90 to -40 -120
		size 18
	active if "!min zoom"
	button - "_-"
		from -50 -90 to -80 -120
		size 18



interface "map"
	value "max zoom" 2
	value "min zoom" -2
	value "zoom animation duration" 10

	anchor top
	string "route error"
		center 1 59
		size 18
		color "map route error shadow"
	string "route error"
		center 0 58
		size 18
		color "map route error text"



