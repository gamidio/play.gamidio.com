	red   0 1 0 0
	green 0 0 1 0
	blue  0 1 0 0
	alpha 0 0 0 1

# 25 pure magenta
swizzle "25"
	red   1 0 0 0
	green 0 0 1 0
	blue  1 0 0 0
	alpha 0 0 0 1

# 26 faded magenta
swizzle "26"
	red   1 0 0 0
	green 0 1 0 0
	blue  1 0 0 0
	alpha 0 0 0 1

# 27 red only (cloaked)
swizzle "27"
	override

	red   0 0 1 0
	green 0 0 0 0
	blue  0 0 0 0
	alpha 0 0 0 1

# 28 black only (outline)
swizzle "28"
	override

	red   0 0 0 0
	green 0 0 0 0
	blue  0 0 0 0
	alpha 0 0 0 1
