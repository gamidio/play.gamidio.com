		"lifetime" 100
		"reload" 20
		"firing energy" 60
		"firing heat" 150
		"acceleration" 1
		"drag" .1
		"turn" .2
		"homing"
			"leading"
			"throttle control"
		"tracking" .7
		"shield damage" 108
		"hull damage" 32
		"hit force" -240
	description "Korath Grab-Strike projectiles are designed to pull a target closer to the Korath ship, to keep it from escaping."

