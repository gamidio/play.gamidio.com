	on offer
		give ship "Emerald Sword (Fixed)" "Emerald Sword"
		give ship "Black Diamond" "Stormheart"
		give ship "Black Diamond" "Onyx Chariot"
		give ship "Black Diamond" "Firebrand"
		give ship "Black Diamond" "Frostherald"
