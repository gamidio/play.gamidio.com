		has "event: war begins"
		not "event: initial deployment 2"
		random < 25
	source
		near Pollux 2 10
	destination Martini
	on visit
		dialog phrase "generic cargo on visit"
	on complete
		payment 6000 170
		dialog phrase "generic cargo delivery payment"


