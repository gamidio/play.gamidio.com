	deadline 8
	to offer
		random < 7
		has "landing access: Sunracer"
	source Solace
	destination Sunracer
	on visit
		dialog phrase "generic cargo and passenger on visit"
	on complete
		payment
		payment 23000
		dialog `You drop off the racing team with their hovercraft and collect your payment of <payment>.`
