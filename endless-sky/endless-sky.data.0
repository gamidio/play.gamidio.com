outfit "Slipstream Projector"
	category "Guns"
	series "Guns"
	index 91030
	cost 18000000
	thumbnail "outfit/unknown"
	"mass" 200
	"outfit space" -200
	"weapon capacity" -200
	"gun ports" -1
	"required crew" 1
