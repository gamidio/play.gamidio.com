		government "Bounty"
		personality heroic unconstrained staying marked target tracked
		system
			distance 4 5
			attributes "rim" "south" "north" "dirt belt" "core" "frontier"
			not system "Ultima Thule"
		fleet "Marauder fleet IX"
		dialog phrase "generic hunted bounty fleet eliminated and payment dialog"
		on kill
			payment 800000
			fail

mission "Bounty Hunting (Marauder X)"
	name "Infamous Marauders near <system>"
	description "The legendary <npc> and its accompanying fleet have been terrorizing merchants and law enforcement in this region of space. Destroy the whole fleet for payment (<payment>). Be warned that the <npc> is known to ambush those attempting to hunt them."
