# Final phrases that make ship names

# e.g.
# Honorable Guardian
# Poor Richard
# Golden Mary
# Infinite Mystery
phrase "civilian subphrase 1"
	phrase
		"adjectives"
	word
		" "
	phrase
		"male names" 124
		"female names" 132
		"singular nouns" 202
		"plural nouns" 142
		"nouns of indeterminate quantity" 103
	phrase
		"sometimes a successor"

# e.g.:
# Falcon Jewel
# Pyramid Names
# Cobalt Winds
phrase "civilian subphrase 2"
	phrase
		"adjectives" 165
		"singular nouns" 202
		"nouns of indeterminate quantity" 103
	word
		" "
	phrase
		"singular nouns" 202
		"plural nouns" 142

# e.g.:
# Xu's Flags
# Katerina's Silhouette
# Aletheia's Money Pit
# Lord's Whispers
phrase "civilian subphrase 3"
	phrase
		"male names" 2
		"male titles" 1
		"female names" 2
		"female titles" 1
		"gender-neutral titles" 1
	word
		"%'s "
	phrase
		"singular nouns" 202
		"plural nouns" 142
		"nouns of indeterminate quantity" 103
	# When making a word ending in "s" possessive, only add an apostrophe.
	replace
		"s%'s" "s'"
		"%" ""

# e.g.:
# Words and Changes
# Beauty and Legends
# Tears and Sorrow
phrase "civilian subphrase 4"
	phrase
		"plural nouns" 142
		"nouns of indeterminate quantity" 103
	word
		" and "
	phrase
		"plural nouns" 142
		"nouns of indeterminate quantity" 103

# e.g.:
# Four Clouds
# Infinite Riches
# Too Many Men
phrase "civilian subphrase 5"
	phrase
		"plural quantities"
	word
		" "
	phrase
		"plural nouns"

# e.g.:
# King of the Mountain
# Champion Ivan
phrase "civilian subphrase 6"
	phrase
		"male titles" 1
		"gender-neutral titles" 1
	word
		" "
	phrase
		"male names" 124
		"things you can be of" 416

# e.g.:
# Queen of Thoughts
# Lady Caroline
phrase "civilian subphrase 7"
	phrase
		"female titles" 1
		"gender-neutral titles" 1
	word
		" "
	phrase
		"female names" 132
		"things you can be of" 416

